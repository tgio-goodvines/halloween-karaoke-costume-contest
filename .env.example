HALLOWEEN_APP_SECRET=<flask-session-secret>
HALLOWEEN_ADMIN_PASSWORD=<admin-password>
HALLOWEEN_REDIS_HOST=127.0.0.1
HALLOWEEN_REDIS_PORT=6379
HALLOWEEN_REDIS_DB=1
HALLOWEEN_REDIS_USERNAME=<local-redis-acl-user>
HALLOWEEN_REDIS_PASSWORD=<local-redis-acl-password>
HALLOWEEN_REDIS_PREFIX=halloween
HALLOWEEN_REDIS_URL=redis://<local-redis-acl-user>:<local-redis-acl-password>@127.0.0.1:6379/1
HALLOWEEN_DISPLAY_WIFI_NETWORK="Halloween Party WiFi"
HALLOWEEN_DISPLAY_WIFI_PASSWORD=halloween
HALLOWEEN_EMAIL_UPDATES_ENABLED=false
HALLOWEEN_SES_REGION=us-east-1
HALLOWEEN_EMAIL_FROM="Qiana and Tony's Halloween Party <no-reply@tnq-halloween.com>"
HALLOWEEN_PUBLIC_BASE_URL=https://tnq-halloween.com
# Configure one of the following MusicKit options through Vault in production.
# Never commit a Media Services .p8 private key or developer token.
HALLOWEEN_APPLE_MUSIC_DEVELOPER_TOKEN=
HALLOWEEN_APPLE_MUSIC_TEAM_ID=
HALLOWEEN_APPLE_MUSIC_KEY_ID=
HALLOWEEN_APPLE_MUSIC_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----"
HALLOWEEN_APPLE_MUSIC_STOREFRONT=us
# YouTube karaoke is disabled by default. Production values are loaded from
# Vault path appsecrets/halloween_youtube, never committed here.
HALLOWEEN_YOUTUBE_KARAOKE_ENABLED=false
HALLOWEEN_YOUTUBE_API_KEY=
HALLOWEEN_YOUTUBE_CLIENT_ID=
HALLOWEEN_YOUTUBE_CLIENT_SECRET=
HALLOWEEN_YOUTUBE_REFRESH_TOKEN=
HALLOWEEN_YOUTUBE_REGION_CODE=US
HALLOWEEN_YOUTUBE_SEARCH_DAILY_BUDGET=90
HALLOWEEN_YOUTUBE_SEARCH_ACCOUNT_LIMIT=10
HALLOWEEN_YOUTUBE_VAULT_AWS_AUTH_ROLE=halloween-api
HALLOWEEN_YOUTUBE_VAULT_SECRET_PATH=appsecrets/halloween_youtube
